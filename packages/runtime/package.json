{
  "name": "@opencode-ai/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Runtime abstraction layer for cross-runtime compatibility (Bun/Deno/Node)",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./adapters/bun": "./src/adapters/bun.ts",
    "./adapters/deno": "./src/adapters/deno.ts",
    "./adapters/node": "./src/adapters/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:deno": "deno test --allow-all",
    "test:node": "npx tsx src/test-node.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.21.0"
  },
  "optionalDependencies": {
    "fast-glob": "^3.3.2",
    "micromatch": "^4.0.8"
  }
}
